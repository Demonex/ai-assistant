{
  "name": "@repo/admin",
  "version": "1.0.0",
  "description": "Admin panel",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation cross-env next dev -p 2055",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "docker:build": "docker buildx build --platform linux/amd64 -t bardakdev/payload -f nginx.Dockerfile . --no-cache",
    "docker:run": "docker run -p 80:80 --rm bardakdev/payload",
    "serve": "cross-env node server.js"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.8.0",
    "@payloadcms/next": "3.2.2",
    "@payloadcms/richtext-lexical": "3.2.2",
    "@payloadcms/ui": "3.2.2",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@stigma.io/payloadcms-storage-s3": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie": "1.0.2",
    "cookie-signature": "1.2.2",
    "cross-env": "7.0.3",
    "express": "4.21.1",
    "graphql": "16.9.0",
    "ioredis": "5.4.1",
    "lucide-react": "0.462.0",
    "next": "15.0.3",
    "payload": "3.2.2",
    "prism-react-renderer": "2.4.0",
    "react": "19.0.0-rc.1",
    "react-dom": "19.0.0-rc.1",
    "tailwind-merge": "2.5.5",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.15",
    "@types/cookie-signature": "1.1.2",
    "@types/node": "22.10.1",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.7.2"
  }
}
