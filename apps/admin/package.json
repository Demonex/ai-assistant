{
	"name": "@repo/admin",
	"version": "1.0.0",
	"description": "Admin panel",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=--no-deprecation next build",
		"dev": "pnpm run dotenvchecker && cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=development node server.js",
		"lint": "eslint src --report-unused-disable-directives --fix",
		"format": "prettier --write --ignore-path .prettierignore src/**/*.{ts,tsx,js,jsx,json,md}",
		"dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
		"start": "pnpm run dotenvchecker && cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production node server.js",
		"docker:build": "docker buildx build --platform linux/amd64 -t bardakdev/payload -f nginx.Dockerfile . --no-cache",
		"docker:run": "docker run -p 80:80 --rm bardakdev/payload",
		"serve": "cross-env node server.js",
		"dotenvchecker": "dotenv-checker --schema .env.example --env .env"
	},
	"dependencies": {
		"@hookform/resolvers": "^4.1.2",
		"@payloadcms/db-postgres": "3.11.0",
		"@payloadcms/next": "3.11.0",
		"@payloadcms/richtext-lexical": "3.11.0",
		"@payloadcms/translations": "3.11.0",
		"@payloadcms/ui": "3.11.0",
		"@radix-ui/primitive": "^1.1.1",
		"@radix-ui/react-checkbox": "1.1.3",
		"@radix-ui/react-label": "2.1.1",
		"@radix-ui/react-primitive": "^2.0.2",
		"@radix-ui/react-progress": "^1.1.2",
		"@radix-ui/react-select": "2.1.4",
		"@radix-ui/react-slot": "1.1.1",
		"@stigma.io/payloadcms-storage-s3": "workspace:*",
		"axios": "^1.7.9",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cookie": "1.0.2",
		"cookie-parser": "1.4.7",
		"cookie-signature": "1.2.2",
		"cookies-next": "^5.1.0",
		"cors": "2.8.5",
		"cross-env": "7.0.3",
		"dotenv-checker": "1.1.7",
		"express": "4.21.2",
		"graphql": "16.9.0",
		"ioredis": "5.4.2",
		"lucide-react": "0.462.0",
		"next": "15.1.2",
		"next-themes": "^0.4.4",
		"payload": "3.11.0",
		"pretty-bytes": "^6.1.1",
		"prism-react-renderer": "2.4.0",
		"prompts": "^2.4.2",
		"react": "19.0.0-rc.1",
		"react-dom": "19.0.0-rc.1",
		"react-dropzone": "^14.3.8",
		"react-hook-form": "^7.54.2",
		"sonner": "^2.0.1",
		"tailwind-merge": "2.5.5",
		"tailwindcss-animate": "1.0.7",
		"use-mono-hook": "^0.2.3",
		"wouter": "^3.3.5",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@typescript-eslint/eslint-plugin": "^7.7.0",
		"@typescript-eslint/parser": "^7.7.0",
		"eslint": "^9.23.0",
		"prettier": "3.5.3",
		"@import-meta-env/unplugin": "^0.6.2",
		"@repo/web": "workspace:*",
		"@tailwindcss/typography": "0.5.15",
		"@types/cookie-signature": "1.1.2",
		"@types/cors": "2.8.17",
		"@types/node": "22.10.2",
		"@types/react": "npm:types-react@19.0.0-rc.1",
		"@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
		"autoprefixer": "10.4.20",
		"postcss": "8.4.49",
		"tailwindcss": "3.4.17",
		"tailwindcss-scoped-preflight": "^3.4.10",
		"typescript": "5.7.2"
	}
}
