{
	"extends": ["//"],
	"globalDependencies": [".env", "**/.env.*local"],
	"tasks": {
		"build": {
			"env": ["NODE_ENV"],
			"dependsOn": ["^build"],
			"outputs": []
		},
		"lint": {
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"],
			"inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
		},
		"compile": {
			"dependsOn": ["^compile"]
		},
		"clean": {
			"dependsOn": ["^clean"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"format": {
			"cache": false
		}
	}
}
