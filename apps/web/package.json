{
	"type": "module",
	"name": "@repo/web",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev:server": "cross-env NODE_ENV=development npx ts-node-dev server",
		"dev:client": "vite --config vite.config.ts dev --host",
		"dev": "pnpm run dev:client",
		"build": "rimraf dist && pnpm run build:client && pnpm run build:server",
		"build:client": "cross-env vite build --outDir dist/client --mode=${VITE_MODE:-production}",
		"build:server": "cross-env vite build --ssr src/entry-server.tsx --outDir dist/server --mode=${VITE_MODE:-production}",
		"prerender": "cross-env NODE_ENV=production pnpm swc prerender.mts -d dist && NODE_ENV=production node -r node-window-polyfill/register dist/prerender.js",
		"build:clean": "rm -rf dist/client/assets/tailwind",
		"serve": "cross-env NODE_ENV=production npx node dist/server.mjs",
		"lint": "eslint src --report-unused-disable-directives --fix",
		"format": "prettier --write src/**/*.{ts,tsx,js,jsx,json,md}",
		"ssg": "serve dist/client",
		"depcheck": "npx depcheck",
		"build:push": "docker buildx build --platform linux/amd64 --no-cache -t bardakdev/rifify-nginx -f Dockerfile . --no-cache --push",
		"certbot:push": "docker buildx build --platform linux/amd64 --no-cache -t bardakdev/rifify-certbot --no-cache -f certbot.Dockerfile . --no-cache --push"
	},
	"dependencies": {
		"@amcharts/amcharts4": "^4.10.39",
		"@amcharts/amcharts4-geodata": "^4.1.30",
		"@headlessui/react": "^1.7.19",
		"@heroicons/react": "^2.2.0",
		"@radix-ui/react-accordion": "^1.2.3",
		"@radix-ui/react-avatar": "^1.1.2",
		"@radix-ui/react-collapsible": "^1.1.2",
		"@radix-ui/react-dialog": "^1.1.4",
		"@radix-ui/react-dropdown-menu": "^2.1.4",
		"@radix-ui/react-label": "2.1.1",
		"@radix-ui/react-radio-group": "^1.2.2",
		"@radix-ui/react-scroll-area": "^1.2.2",
		"@radix-ui/react-select": "2.1.4",
		"@radix-ui/react-separator": "^1.1.1",
		"@radix-ui/react-slider": "^1.2.2",
		"@radix-ui/react-slot": "1.1.1",
		"@radix-ui/react-switch": "^1.1.2",
		"@radix-ui/react-toast": "^1.2.6",
		"@radix-ui/react-tooltip": "^1.1.6",
		"@tailwindcss/forms": "^0.5.10",
		"@tanstack/react-table": "^8.20.6",
		"@types/lodash.shuffle": "^4.2.9",
		"@uidotdev/usehooks": "^2.4.1",
		"@vitejs/plugin-react-swc": "^3.7.2",
		"axios": "^1.7.9",
		"axios-cache-interceptor": "^1.6.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"es-dirname": "^0.1.0",
		"globalthis": "^1.0.4",
		"lodash.capitalize": "^4.2.1",
		"lodash.chunk": "^4.2.0",
		"lodash.debounce": "^4.0.8",
		"lodash.get": "^4.4.2",
		"lodash.sample": "^4.2.1",
		"lodash.set": "^4.3.2",
		"lodash.shuffle": "^4.2.0",
		"lucide-react": "0.473.0",
		"luxon": "^3.5.0",
		"memoize": "^10.0.0",
		"memoizee": "^0.4.17",
		"popmotion": "^11.0.5",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-hook-form": "^7.54.2",
		"react-markdown": "^9.0.3",
		"react-use": "^17.6.0",
		"recharts": "^2.15.0",
		"remove": "^0.1.5",
		"tailwind-merge": "2.5.5",
		"tailwindcss-animate": "1.0.7",
		"use-between": "^1.3.5",
		"use-mono-hook": "^0.2.3",
		"validator": "^13.12.0",
		"wouter": "^3.3.5"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@typescript-eslint/eslint-plugin": "^7.7.0",
		"@typescript-eslint/parser": "^7.7.0",
		"eslint": "^9.23.0",
		"prettier": "3.5.3",
		"@swc/cli": "^0.1.65",
		"@swc/core": "^1.10.7",
		"@types/compression": "1.7.2",
		"@types/express": "4.17.14",
		"@types/fs-extra": "^9.0.13",
		"@types/lodash.capitalize": "^4.2.9",
		"@types/lodash.chunk": "^4.2.9",
		"@types/lodash.debounce": "^4.0.9",
		"@types/lodash.get": "^4.4.9",
		"@types/lodash.sample": "^4.2.9",
		"@types/lodash.set": "^4.3.9",
		"@types/luxon": "^3.4.2",
		"@types/memoizee": "^0.4.11",
		"@types/react": "npm:types-react@19.0.0-rc.1",
		"@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
		"@types/validator": "^13.12.2",
		"autoprefixer": "^10.4.20",
		"compression": "1.7.4",
		"cross-env": "^7.0.3",
		"express": "4.18.2",
		"fs-extra": "^11.2.0",
		"node-localstorage": "^3.0.5",
		"node-window-polyfill": "^1.0.4",
		"postcss": "^8.5.1",
		"postcss-load-config": "^5.1.0",
		"rimraf": "^6.0.1",
		"sass": "^1.83.4",
		"serve-static": "1.15.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.3",
		"vite": "^5.4.11",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"exports": {
		"./pages/*": "./src/pages/*",
		"./components/*": "./src/components/*",
		"./lib/*": "./src/lib/*",
		"./hooks/*": "./src/hooks/*",
		"./helpers/*": "./src/helpers/*",
		"./utils/*": "./src/utils/*",
		"./constants/*": "./src/constants/*",
		"./types/*": "./src/types/*",
		"./shared/*": "./src/shared/*",
		"./index.css": "./src/index.css"
	}
}
