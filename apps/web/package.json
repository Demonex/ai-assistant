    "remove": "^0.1.5",
    "swiper": "^11.1.3",
    "tailwind-merge": "2.5.5",
    "tailwindcss-animate": "1.0.7",
    "use-between": "^1.3.5",
    "usehooks-ts": "^3.1.0",
    "validator": "^13.12.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@repo/config-biome": "workspace:*",
    "@swc/cli": "^0.1.63",
    "@swc/core": "^1.10.1",
    "@types/compression": "1.7.2",
    "@types/express": "4.17.14",
    "@types/fs-extra": "^9.0.13",
