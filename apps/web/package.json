{
  "type": "module",
  "name": "@repo/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev:server": "cross-env NODE_ENV=development npx ts-node-dev server",
    "dev:client": "vite --config vite.config.ts dev --host",
    "dev": "pnpm run dev:client",
    "build": "rimraf dist && nr build:client && nr build:server && yarn prerender && nr build:clean",
    "build:client": "cross-env vite build --outDir dist/client",
    "build:server": "cross-env vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "cross-env NODE_ENV=production yarn swc prerender.mts -d dist && NODE_ENV=production node -r node-window-polyfill/register dist/prerender.js",
    "build:clean": "rm -rf dist/client/assets/tailwind",
    "serve": "cross-env NODE_ENV=production npx node dist/server.mjs",
    "lint": "biome lint --write src",
    "format": "biome format --write src",
    "ssg": "serve dist/client",
    "depcheck": "npx depcheck",
    "build:push": "docker buildx build --platform linux/amd64 --no-cache -t bardakdev/rifify-nginx -f Dockerfile . --no-cache --push",
    "certbot:push": "docker buildx build --platform linux/amd64 --no-cache -t bardakdev/rifify-certbot --no-cache -f certbot.Dockerfile . --no-cache --push"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.38",
    "@amcharts/amcharts4-geodata": "^4.1.28",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tailwindcss/forms": "^0.5.7",
    "@tanstack/react-table": "^8.17.3",
    "@types/lodash.shuffle": "^4.2.9",
    "@uidotdev/usehooks": "^2.4.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "add": "^2.0.6",
    "axios": "^1.7.9",
    "axios-cache-interceptor": "^1.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "es-dirname": "^0.1.0",
    "framer-motion": "^11.3.29",
    "human-number": "^2.0.4",
    "i18next": "22.5.1",
    "i18next-browser-languagedetector": "6.1.8",
    "lodash.capitalize": "^4.2.1",
    "lodash.chunk": "^4.2.0",
    "lodash.debounce": "^4.0.8",
    "lodash.get": "^4.4.2",
    "lodash.sample": "^4.2.1",
    "lodash.set": "^4.3.2",
    "lodash.shuffle": "^4.2.0",
    "lucide-react": "0.462.0",
    "luxon": "^3.4.4",
    "memoize": "^10.0.0",
    "memoizee": "^0.4.15",
    "popmotion": "^11.0.5",
    "random-words": "^2.0.1",
    "react": "18.3.1",
    "react-circular-progressbar": "^2.1.0",
    "react-dom": "18.3.1",
