{
	"name": "monorepo",
	"description": "TS monorepo setup",
	"version": "0.0.0-development",
	"private": true,
	"license": "GNU LGPL",
	"scripts": {
		"pnpm:devPreinstall": "git submodule update --init --recursive --remote",
		"postinstall": "lefthook install",
		"compile": "turbo run compile",
		"build:backend": "turbo run build --filter=@repo/backend",
		"build:admin": "turbo run build --filter=@repo/admin",
		"build:web": "turbo run build --filter=@repo/web",
		"prune:backend": "turbo prune @repo/backend --docker",
		"prune:admin": "turbo prune @repo/admin --docker",
		"prune:web": "turbo prune @repo/web --docker",
		"clean": "turbo run clean",
		"predev:*": "mkdirp .turbo/daemon",
		"lint": "turbo run lint --parallel",
		"format": "turbo run format --parallel",
		"test": "turbo run test -- --watch false",
		"dev:admin": "pnpm run predev:* && turbo daemon clean && turbo --parallel --ui=tui dev --log-prefix=none --filter=@repo/admin",
		"dev:admin:types": "pnpm run predev:* && turbo daemon clean && turbo --parallel --ui=tui generate:types --log-prefix=none --filter=@repo/admin",
		"dev:admin:imports": "pnpm run predev:* && turbo daemon clean && turbo --parallel --ui=tui generate:importmap --log-prefix=none --filter=@repo/admin",
		"dev:backend": "turbo --parallel run dev --log-prefix=none --filter=@repo/backend",
		"dev:backend:watch": "turbo --parallel watch build --log-prefix=none --filter=@repo/backend",
		"dev:backend:all": "pnpm run dev:backend & pnpm run dev:backend:watch",
		"dev:backend:docker": "turbo --parallel run docker-compose --log-prefix=none --filter=@repo/backend",
		"dev:web": "pnpm run predev:* && turbo daemon clean && turbo run dev --log-prefix=none --filter=@repo/web"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@typescript-eslint/eslint-plugin": "^8.28.0",
		"@typescript-eslint/parser": "^8.28.0",
		"eslint": "^9.23.0",
		"lefthook": "1.10.0",
		"mkdirp": "^3.0.1",
		"prettier": "3.5.3",
		"turbo": "2.3.3",
		"typescript": "5.7.2",
		"vitest": "2.1.8"
	},
	"packageManager": "pnpm@10.4.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@nestjs/core",
			"@parcel/watcher",
			"@scarf/scarf",
			"@swc/core",
			"bcrypt",
			"bufferutil",
			"core-js",
			"es5-ext",
			"esbuild",
			"lefthook",
			"sharp",
			"utf-8-validate"
		]
	}
}
