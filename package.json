{
  "name": "monorepo",
  "description": "TS monorepo setup",
  "version": "0.0.0-development",
  "private": true,
  "license": "GNU LGPL",
  "scripts": {
    "pnpm:devPreinstall": "git submodule update --init --recursive --remote",
    "postinstall": "lefthook install",
    "compile": "turbo run compile",
    "build": "turbo run build --filter=@repo/backend",
    "clean": "turbo run clean",
    "predev:*": "mkdirp .turbo/daemon",
    "dev:admin": "pnpm run predev:* && turbo daemon clean && turbo --parallel watch build dev --log-prefix=none --filter=@repo/admin",
    "dev:backend": "pnpm run predev:* && turbo daemon clean && turbo --parallel watch build dev --log-prefix=none --filter=@repo/backend",
    "dev:web": "pnpm run predev:* && turbo daemon clean && turbo run dev --log-prefix=none --filter=@repo/web",
    "lint": "turbo run lint --parallel",
    "format": "turbo run format --parallel",
    "test": "turbo run test -- --watch false"
  },
  "devDependencies": {
    "lefthook": "1.9.0",
    "mkdirp": "^3.0.1",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
