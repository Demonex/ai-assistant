    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^9.23.0",
    "prettier": "3.5.3",
    "@repo/config-typescript": "workspace:*",
    "@swc/core": "1.10.1",
    "@types/node": "22.10.2",
    "del-cli": "6.0.0",
    "remeda": "2.19.0",
