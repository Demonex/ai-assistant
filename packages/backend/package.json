		"@types/passport": "1.0.17",
		"@types/passport-facebook": "2.1.11",
		"@types/passport-google-oauth20": "2.0.16",
		"del-cli": "6.0.0",
		"remeda": "2.17.4",
		"tsup": "8.3.5",
		"typescript": "5.7.2",
		"vitest": "2.1.8",
		"wait-on": "8.0.1"
	}
