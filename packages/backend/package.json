{
	"name": "@repo/backend",
	"version": "0.0.0-development",
	"type": "module",
	"license": "GNU LGPL",
	"scripts": {
		"compile": "tsc --noEmit",
		"test": "vitest",
		"build": "del-cli -f dist/build.info && tsup-node",
		"lint": "biome lint --write src",
		"format": "biome format --write src",
		"dev": "pnpm run dotenvchecker && nest start -b swc -w",
		"serve:office": "node --trace-warnings -r dotenv/config dist/index.js dotenv_config_path=.env.office",
		"clean": "del-cli dist/build.info",
		"docker-compose": "docker-compose up -d --remove-orphans",
		"coverage": "vitest run --coverage",
		"depcheck": "pnpx depcheck",
		"dotenvchecker": "dotenv-checker --schema .env.example --env .env"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.732.0",
		"@aws-sdk/lib-storage": "3.732.0",
		"@mailchimp/mailchimp_transactional": "1.0.59",
		"@mikro-orm/core": "6.4.3",
		"@mikro-orm/nestjs": "6.0.2",
		"@mikro-orm/postgresql": "6.4.3",
		"@nestjs-modules/ioredis": "2.0.2",
		"@nestjs/common": "11.0.4",
		"@nestjs/core": "11.0.4",
		"@nestjs/passport": "11.0.4",
		"@nestjs/platform-express": "11.0.4",
		"@nestjs/schedule": "5.0.0",
		"@nestjs/swagger": "11.0.2",
		"@repo/auth": "workspace:*",
		"@repo/common": "workspace:*",
		"apple-auth": "1.0.9",
		"awesome-phonenumber": "6.4.0",
		"base64-url": "2.3.3",
		"bcryptjs": "^3.0.2",
		"better-randstr": "2.0.0",
		"bson": "4.7.2",
		"chalk": "5.4.1",
		"class-transformer": "0.5.1",
		"class-validator": "0.14.1",
		"connect-redis": "8.0.1",
		"cookie-parser": "1.4.7",
		"cors": "2.8.5",
		"dotenv": "16.4.7",
		"dotenv-checker": "1.1.7",
		"escape-html": "1.0.3",
		"express": "4.21.2",
		"express-session": "1.18.1",
		"form-data": "^4.0.1",
		"got": "14.4.5",
		"ioredis": "5.4.2",
		"lodash-es": "4.17.21",
		"memoizee": "^0.4.15",
		"passport": "0.6.0",
		"passport-facebook": "3.0.0",
		"passport-google-oauth20": "2.0.0",
		"reflect-metadata": "0.2.2",
		"uuid": "11.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@nestjs/cli": "^11.0.2",
		"@repo/config-biome": "workspace:*",
		"@repo/config-typescript": "workspace:*",
		"@swc/cli": "0.6.0",
		"@swc/core": "1.10.9",
		"@types/bcrypt": "5.0.2",
		"@types/cookie-parser": "1.4.8",
		"@types/cors": "2.8.17",
		"@types/escape-html": "1.0.4",
		"@types/express": "5.0.0",
		"@types/express-session": "1.18.1",
		"@types/lodash-es": "4.17.12",
		"@types/mailchimp__mailchimp_transactional": "1.0.10",
		"@types/md5": "2.3.5",
		"@types/memoizee": "^0.4.11",
		"@types/node": "22.10.7",
		"@types/passport": "1.0.17",
		"@types/passport-facebook": "2.1.11",
		"@types/passport-google-oauth20": "2.0.16",
		"del-cli": "6.0.0",
		"remeda": "2.19.2",
		"tsup": "8.3.5",
		"typescript": "5.7.3",
		"vitest": "2.1.8",
		"wait-on": "8.0.2"
	},
	"packageManager": "pnpm@10.3.0"
}
