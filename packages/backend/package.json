{
	"name": "@repo/backend",
	"version": "0.0.0-development",
	"type": "module",
	"license": "GNU LGPL",
	"scripts": {
		"compile": "tsc --noEmit",
		"test": "vitest",
		"build": "tsup-node",
		"lint": "biome lint src",
		"format": "biome format src --write",
		"dev": "pnpm run clean && pnpm run docker-compose && wait-on dist/build.info && node --no-deprecation --trace-warnings --enable-source-maps --watch -r dotenv/config dist/index.js",
		"serve": "node --trace-warnings -r dotenv/config dist/index.js",
		"clean": "del-cli dist",
		"docker-compose": "docker-compose up -d --remove-orphans",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@mailchimp/mailchimp_transactional": "1.0.59",
		"@nestjs-modules/ioredis": "2.0.2",
		"@nestjs/common": "10.4.15",
		"@nestjs/core": "10.4.15",
		"@nestjs/passport": "9.0.0",
		"@nestjs/platform-express": "10.4.15",
		"@nestjs/schedule": "3.0.4",
		"@nestjs/swagger": "8.1.0",
		"@repo/auth": "workspace:*",
		"@repo/common": "workspace:*",
		"@stigma-io/typegoose-cursor-pagination": "workspace:*",
		"@typegoose/typegoose": "12.9.1",
		"apple-auth": "1.0.9",
		"awesome-phonenumber": "6.4.0",
		"axios": "1.7.8",
		"base64-url": "2.3.3",
		"bcrypt": "5.1.1",
		"better-randstr": "2.0.0",
		"bson": "4.7.2",
		"chalk": "5.3.0",
		"class-transformer": "0.5.1",
		"class-validator": "0.14.1",
		"connect-redis": "8.0.1",
		"cookie-parser": "1.4.7",
		"cookie-signature": "1.2.2",
		"cors": "2.8.5",
		"dotenv": "16.4.7",
		"escape-html": "1.0.3",
		"express": "4.21.1",
		"express-session": "1.18.1",
		"got": "14.4.5",
		"ioredis": "5.4.1",
		"jsonwebtoken": "9.0.2",
		"lodash-es": "4.17.21",
		"md5": "2.3.0",
		"mongodb": "6.12.0",
		"mongoose": "8.8.3",
		"mongoose-autopopulate": "1.1.0",
		"nestjs-typegoose": "7.1.38",
		"nodemailer": "6.9.16",
		"object-path": "0.11.8",
		"passport": "0.6.0",
		"passport-facebook": "3.0.0",
		"passport-google-oauth20": "2.0.0",
		"reflect-metadata": "0.2.2",
		"uuid": "11.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@repo/config-biome": "workspace:*",
		"@repo/config-typescript": "workspace:*",
		"@swc/core": "1.9.3",
		"@types/bcrypt": "5.0.2",
		"@types/cookie-parser": "1.4.8",
		"@types/cookie-signature": "1.1.2",
		"@types/cors": "2.8.17",
		"@types/escape-html": "1.0.4",
