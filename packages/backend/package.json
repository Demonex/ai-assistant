{
  "name": "@stigma-io/rifify-backend",
  "description": "backend",
  "version": "0.0.0-development",
  "license": "GNU LGPL",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "scripts": {
    "copyfiles": "copyfiles -u 1 src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json,csv} dist/",
    "pre:debug": "yarn copyfiles && yarn build:server",
    "start": "cross-env docker compose up -d --build --remove-orphans && cross-env vite --host",
    "start:backend": "nr start",
    "start:backend:old": "DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose up -d --build --remove-orphans && SWCRC=true node --trace-warnings --watch -r \"dotenv/config\" --import @swc-node/register/esm-register src/index.ts",
    "build:payload": "payload build",
    "build:server": "tsc",
    "build": "rm -rf dist build && yarn copyfiles && yarn build:server",
    "serve": "node -r \"dotenv/config\" dist/index.js",
    "generate:types": "payload generate:types",
    "build:docker": "docker buildx build --push --platform linux/amd64 -t bardakdev/rifify .",
    "payload": "dotenv -- payload",
    "dev": "cross-env vite --host"
  },
