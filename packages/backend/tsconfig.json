{
  "extends": "@repo/config-typescript/service.json",
  "references": [
    {
      "path": "../common"
    },
    {
      "path": "../../services/auth"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@repo/backend/*": [
        "./src/*"
      ]
    },
    "target": "ESNext",
    "module": "NodeNext",
    "noLib": false,
    "emitDecoratorMetadata": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": false,
    "strict": false,
    "moduleResolution": "NodeNext",
    "lib": [
      "esnext"
    ],
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "${configDir}/src",
    "${configDir}/*.ts"
  ]
}
