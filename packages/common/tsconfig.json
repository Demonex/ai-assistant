{
  "extends": "@repo/config-typescript/library.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "noLib": false,
    "emitDecoratorMetadata": true,
    "checkJs": true,
    "noEmit": false,
    "strict": false,
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true
  }
}
