{
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"importOrder": ["^react", "^@?\\w", "^@/", "^[./]"],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"trailingComma": "all",
	"proseWrap": "always",
	"printWidth": 80,
	"tabWidth": 2,
	"useTabs": true,
	"endOfLine": "lf",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"overrides": [
		{
			"files": "*.ts",
			"options": {
				"parser": "babel-ts"
			}
		},
		{
			"files": "*.tsx",
			"options": {
				"parser": "typescript"
			}
		}
	]
}
